{
  "expo": {
    "name": "Try Jesus: The Journey",
    "slug": "try-jesus-the-journey",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "tryjesusjourney",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tryjesusmedia.journey"
    },
    "android": {
      "package": "com.tryjesusmedia.journey",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-padded.png",
        "backgroundColor": "#311E33"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "live-discussion"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#171418"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9de4b261-f4d1-4e8d-84b1-c817cae87413"
      }
    },
    "owner": "try-jesus-media"
  }
}
